# Server-only example. Copy to the ignored root .env and load it explicitly:
# node --env-file=.env --import tsx packages/api/src/http.ts
# Package scripts do NOT automatically load this file.
# Existing shell variables override values loaded by Node --env-file.

# Offline default. Do not switch to paypal casually: later approval/checks can capture.
PAYMENT_PROVIDER=mock
PAYPAL_ENV=sandbox
API_HOST=127.0.0.1
API_PORT=4781
# PORT, if set, takes precedence over API_PORT.
# PORT=
DATA_DIR=./data
REORDER_INTERVAL_MS=900000
PREFERRED_SKU=RC-SMALL-8
# SQLITE_PATH=
# WEB_ROOT=
# Leave DATABASE_URL unset: Postgres is not implemented.

# Optional model intent parsing. Leave blank for supported local rule parsing.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_TIMEOUT_MS=8000
# Lower-priority optional providers; never prefix these names with VITE_.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Your own independent Sandbox application only. Never commit actual values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# PAYPAL_VAULT_FILE=./data/paypal-vault.json
# PAYPAL_VAULT_ID=
# Web Connect requests card vaulting. Advanced CLI source selection is separate.
# PAYPAL_VAULT_SOURCE=auto
# PAYPAL_TEST_CARD_NUMBER=
# PAYPAL_TEST_CARD_EXPIRY=2028-12
# PAYPAL_TEST_CARD_CVV=
# PAYPAL_TEST_CARD_NAME=
# PAYPAL_RETURN_URL=http://127.0.0.1:4781/paypal
# PAYPAL_CANCEL_URL=http://127.0.0.1:4781/paypal
# PAYPAL_APPROVAL_TIMEOUT_MS=180000
# PAYPAL_APPROVAL_POLL_MS=3000
# PAYPAL_WEBHOOK_URL is exposed as configuration metadata, not a completed webhook integration.
# PAYPAL_WEBHOOK_URL=
# Legacy PAYPAL_WALLET_FALLBACK does not automatically switch after a card refusal.

# Forced reorder, demo reset and recovery writes require a locally chosen value of at least 32 characters.
# Leave blank until deliberately setting up a controlled local scenario.
REPLENISH_MAINTENANCE_TOKEN=

# Optional owner-only Telegram integration; all blank means no Telegram requests.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_BOT_USERNAME=
# PUBLIC_APP_URL=http://127.0.0.1:4781

# Optional standalone simulated store / legacy CLI state, not required by the web API.
STORE_HOST=127.0.0.1
STORE_PORT=4747
# STORE_DATA=./data/store.json
# REPLENISH_DATA=./data/household.json
