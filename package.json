{
  "name": "replenish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "tsx packages/agent/src/demo.ts",
    "demo:paypal": "tsx packages/agent/src/demo-paypal.ts",
    "demo:llm": "tsx packages/domain/src/demo-llm.ts",
    "paypal:diagnose": "tsx packages/agent/src/paypal-diagnose.ts",
    "telegram:chat": "tsx packages/api/scripts/telegram-chat.ts",
    "replenish": "tsx packages/agent/src/cli.ts",
    "store": "tsx packages/store/src/http.ts",
    "mcp": "tsx packages/store/src/mcp.ts",
    "api": "tsx packages/api/src/http.ts",
    "build": "pnpm build:web",
    "build:web": "pnpm --filter @replenish/web build",
    "screenshots": "tsx packages/web/scripts/screenshots.ts",
    "screenshots:submission": "tsx packages/web/scripts/submission.ts",
    "verify:flows": "tsx packages/web/scripts/verify-flows.ts",
    "verify:notifications": "tsx packages/web/scripts/verify-notifications.ts",
    "verify:feedback": "tsx packages/web/scripts/verify-feedback.ts",
    "verify:mobile": "tsx packages/web/scripts/verify-mobile.ts",
    "verify:guide": "tsx packages/web/scripts/verify-guide.ts",
    "preview:acceptance": "tsx packages/web/scripts/acceptance-preview.ts",
    "verify:acceptance": "tsx packages/web/scripts/verify-acceptance.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm verify:flows && pnpm verify:notifications && pnpm verify:feedback && pnpm verify:acceptance && pnpm verify:mobile && pnpm verify:guide"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "jsdom": "^27.0.1",
    "playwright": "^1.56.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
